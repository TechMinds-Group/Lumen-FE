# Prefixo GitHub raw das URLs de download das obras (RN-010).
# Sem esta env, o app usa o fallback hardcoded (mesmo comportamento de produção atual).
# Ex.: VITE_DOWNLOAD_BASE_URL=https://github.com/<org>/<repo>/raw/refs/heads/main/politica/
VITE_DOWNLOAD_BASE_URL=

# Base URL da API Lumen (RN-028). Usada para buscar links de afiliados por obra.
# Sem esta env, o app usa fallback http://localhost:5000.
# Ex.: VITE_API_BASE_URL=https://api.lumen.com
VITE_API_BASE_URL=http://localhost:5000